{
  "defaults": {
    "reviewRequired": false,
    "scope": "Recover and implement only the approved issue criteria and owner decisions recorded in #437. Inspect existing epic branches and PRs before writing new code. Preserve tenant isolation, auditability, numbering and immutable issued invoices. Validate and explicitly apply Product Changes; do not edit the accepted model directly. Publish a reviewable PR with current independent command and synthetic browser evidence. Respect the serial queue and dependency base. Report new contradictory intent or unavailable legal/protocol evidence precisely.",
    "paths": [
      "*"
    ],
    "checks": [
      [
        "npm",
        "ci",
        "--ignore-scripts"
      ],
      [
        "dotnet",
        "restore",
        "Raccord.slnx"
      ],
      [
        "node",
        "src/public-site/build.mjs"
      ],
      [
        "dotnet",
        "test",
        "Raccord.slnx",
        "-c",
        "Release",
        "--no-restore",
        "--filter",
        "FullyQualifiedName!~Raccord.EndToEndTests"
      ],
      [
        "npm",
        "ci",
        "--ignore-scripts",
        "--prefix",
        "src/Raccord.Frontend"
      ],
      [
        "npm",
        "run",
        "lint",
        "--prefix",
        "src/Raccord.Frontend"
      ],
      [
        "npm",
        "run",
        "build",
        "--prefix",
        "src/Raccord.Frontend"
      ],
      [
        "npm",
        "test",
        "--prefix",
        "src/Raccord.Frontend"
      ],
      [
        "npx",
        "--no-install",
        "prodshape",
        "validate"
      ],
      [
        "npx",
        "--no-install",
        "prodshape",
        "citations",
        "verify",
        "--provider",
        "openspec"
      ],
      [
        "bash",
        ".github/scripts/check-e2e-selection.sh"
      ],
      [
        "dotnet",
        "tests/Raccord.EndToEndTests/bin/Release/net10.0/Raccord.EndToEndTests.dll",
        "-filter",
        "/[Quarantine!=true&TestKind!=metadata]",
        "-stopOnFail"
      ]
    ]
  }
}
