// Markdown is linted, not reformatted: markdownlint-cli2 owns Markdown style in this repository and
// Prettier does not touch it. Prose is written one logical paragraph per source line
// (no-hard-wrapped-prose, a custom rule in .markdownlint-rules.cjs), so MD013 line length is off.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "no-hard-wrapped-prose": true
  },
  "customRules": [".markdownlint-rules.cjs"],
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/TestResults/**",
    "apm_modules/**",
    // Generated by APM, OpenSpec and ProductShape, or copied by the lifecycle's adopt step.
    ".agents/**",
    ".claude/**",
    "openspec/schemas/**",
    // The product model and its changes are authored through ProductShape and cited by digest;
    // reformatting them would make every citation stale.
    "docs/product/model/**",
    "docs/product/changes/**"
  ]
}
