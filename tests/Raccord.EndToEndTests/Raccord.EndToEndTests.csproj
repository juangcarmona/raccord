<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <!-- Referencing the Aspire host makes the Aspire tooling emit Projects.Raccord_Aspire, the
             metadata DistributedApplicationTestingBuilder boots. -->
        <ProjectReference Include="..\..\src\root\Raccord.Aspire\Raccord.Aspire.csproj" />
        <ProjectReference Include="..\..\src\Raccord.Infrastructure\Raccord.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
        <None
            Include="..\..\src\public-site\dist\**"
            Link="public-site\%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
