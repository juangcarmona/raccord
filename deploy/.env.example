# Copy to deploy/.env and adjust. Never commit the real .env file.
POSTGRES_DB=raccord
POSTGRES_USER=raccord
# Required: use a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=
# Required: copy the exact image tag or digest from a GitHub Release.
# Prefer ghcr.io/juangcarmona/raccord@sha256:<digest> for a repeatable installation.
RACCORD_IMAGE=
RACCORD_HTTP_PORT=8080
RACCORD_TIME_ZONE=Europe/Madrid
# true loads fictional demo customers and projects into an empty database.
RACCORD_SEED_DEMO_DATA=false
