{
  "$schema": "./node_modules/@juangcarmona/lighthouse/assets/schemas/lighthouse-manifest.schema.json",
  "schemaVersion": 1,
  "baseline": "0.1.0",
  "product": "Raccord",
  "application": {
    "shape": "full-stack",
    "stacks": [
      "dotnet",
      "react",
      "typescript"
    ]
  },
  "profiles": [
    "dotnet-backend",
    "react-web-platform",
    "visual-theme"
  ],
  "integrations": {
    "productShape": null,
    "arcShape": null
  },
  "packages": {
    "sdlc": {
      "name": "@juangcarmona/lighthouse-sdlc",
      "version": "0.22.4"
    },
    "ui": {
      "name": "@juangcarmona/lighthouse-ui",
      "version": "0.2.1"
    }
  },
  "managed": [
    "LIGHTHOUSE.md",
    "scripts/lighthouse-guard.mjs",
    ".husky/commit-msg",
    ".husky/pre-push",
    ".github/workflows/lighthouse.yml",
    ".lighthouse/sdlc.json",
    ".agents/skills/lighthouse-init/SKILL.md",
    ".lighthouse/upgrade.json",
    ".lighthouse/commands.json",
    "docs/profiles/dotnet/README.md",
    "docs/profiles/dotnet/adoption.md",
    "docs/profiles/dotnet/architecture.md",
    "docs/profiles/dotnet/guardrails.md",
    "docs/profiles/dotnet/practices.md",
    "docs/profiles/dotnet/testing-and-development.md",
    "docs/profiles/dotnet/use-cases.md",
    ".agents/skills/lighthouse-dotnet/SKILL.md",
    "docs/profiles/react-web-platform/README.md",
    "docs/profiles/react-web-platform/adoption.md",
    "docs/profiles/react-web-platform/structure.md",
    "docs/profiles/react-web-platform/guardrails.md",
    "docs/profiles/react-web-platform/testing.md",
    ".agents/skills/lighthouse-react-web/SKILL.md",
    "docs/design/DESIGN.md",
    ".agents/skills/lighthouse-ui/SKILL.md"
  ],
  "repository": {
    "layout": [
      "src",
      "docs",
      "infra",
      "scripts"
    ],
    "publicSite": {
      "enabled": true
    },
    "conventions": {
      "commits": "conventional",
      "branchPattern": "^(feat|fix|docs|refactor|test|chore|build|ci|perf|revert)/[1-9]\\d*-[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
