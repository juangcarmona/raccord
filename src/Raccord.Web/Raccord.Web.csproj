<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <!-- The OpenAPI document is the frontend's only view of the backend. Regenerate it with: npm run api:generate (in src/Raccord.Frontend). -->
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../Raccord.Frontend/openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name raccord</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference
            Include="Microsoft.Extensions.ApiDescription.Server"
            PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\modules\Compliance\Raccord.Modules.Compliance\Raccord.Modules.Compliance.csproj" />
        <ProjectReference Include="..\modules\Contacts\Raccord.Modules.Contacts\Raccord.Modules.Contacts.csproj" />
        <ProjectReference Include="..\modules\Invoicing\Raccord.Modules.Invoicing\Raccord.Modules.Invoicing.csproj" />
        <ProjectReference Include="..\modules\Projects\Raccord.Modules.Projects\Raccord.Modules.Projects.csproj" />
        <ProjectReference Include="..\modules\Workspace\Raccord.Modules.Workspace\Raccord.Modules.Workspace.csproj" />
        <ProjectReference Include="..\Raccord.Application\Raccord.Application.csproj" />
        <ProjectReference Include="..\Raccord.Contracts\Raccord.Contracts.csproj" />
        <ProjectReference Include="..\Raccord.Infrastructure\Raccord.Infrastructure.csproj" />
        <ProjectReference Include="..\Raccord.ServiceDefaults\Raccord.ServiceDefaults.csproj" />
        <ProjectReference Include="..\shared\Raccord.BuildingBlocks\Raccord.BuildingBlocks.csproj" />
        <ProjectReference Include="..\shared\Raccord.SharedKernel\Raccord.SharedKernel.csproj" />
    </ItemGroup>
</Project>
