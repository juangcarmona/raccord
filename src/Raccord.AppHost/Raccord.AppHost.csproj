<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>91daf22a-9c09-49d0-9c58-7a15bb52bff8</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Orchestration runs from the AppHost NuGet packages so CI and contributors do not need the Aspire CLI bundle. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raccord.Web\Raccord.Web.csproj" />
  </ItemGroup>

</Project>
